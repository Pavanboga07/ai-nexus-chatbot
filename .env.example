# ============================================================================
# AI Nexus Chatbot (Application A) — Local-First Configuration
# Copy to .env on your local computer. Never commit .env to Git.
# ============================================================================

CHATBOT_PORT=3000
HOST=0.0.0.0

# Local-First SQLite Database (Remains 100% on your local computer)
# Defaults to ~/.ai-nexus-chatbot/chatbot.sqlite (or %LOCALAPPDATA%\ai-nexus-chatbot\chatbot.sqlite on Windows)
CHATBOT_DB_PATH=~/.ai-nexus-chatbot/chatbot.sqlite

# LLM Provider Configuration (Server-Side Only — Never Exposed to Browser or Gateway)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Public AI Nexus Gateway on Render (or http://localhost:4000 for local Gateway dev)
GATEWAY_PUBLIC_URL=https://<render-service>.onrender.com
GATEWAY_WS_URL=wss://<render-service>.onrender.com/ws/node

# Optional legacy/local overrides
GATEWAY_INTERNAL_URL=http://localhost:4000
VITE_GATEWAY_HTTP_URL=http://localhost:4000
VITE_GATEWAY_WS_URL=ws://localhost:4000/ws/node
APP_URL="MY_APP_URL"
